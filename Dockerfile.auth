# 认证服务 Dockerfile
FROM python:3.11-slim

WORKDIR /app

# 仅安装认证服务所需依赖（不需要 pywebview/openpyxl/xlrd）
RUN pip install --no-cache-dir fastapi uvicorn[standard] httpx python-multipart

# 复制代码和模板
COPY auth_service.py .
COPY auth_config.example.json .
COPY templates/ ./templates/

# data 目录通过 volume 挂载，不写入镜像
RUN mkdir -p data

EXPOSE 8001

CMD ["uvicorn", "auth_service:app", "--host", "0.0.0.0", "--port", "8001"]
